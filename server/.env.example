PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.x3ejotj.mongodb.net/whiteboard_db?retryWrites=true&w=majority

# Better Auth: generate the secret with `openssl rand -base64 32` (min 32 chars, keep private)
BETTER_AUTH_SECRET=replace_with_a_long_random_secret
# Public URL the browser uses to reach /api/auth (the frontend origin, since /api is proxied)
BETTER_AUTH_URL=http://localhost:5173
# Optional: comma-separated headers carrying the real client IP behind your proxy (default: x-forwarded-for)
# AUTH_IP_HEADERS=
CLIENT_URL=http://localhost:5173,http://127.0.0.1:5173,https://vairaa-whiteboard.vercel.app

# Email delivery (required): either Gmail with an App Password...
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password
# ...or any SMTP provider (takes priority over Gmail when SMTP_HOST is set)
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
SMTP_FROM="Vairaa Whiteboard <noreply@whiteboard.com>"

